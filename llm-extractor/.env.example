# Copy this file to .env and fill in your key. Never commit .env.
NVIDIA_API_KEY=

# Optional overrides (defaults are in flu_extractor/config.py; README section 8)
# NVIDIA_MODEL_ID=deepseek-ai/deepseek-v4.1-flash
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_REQUESTS_PER_MINUTE=40
# REQUEST_TIMEOUT_SECONDS=900
# PROMPT_VERSION=v5.2
# EXAMPLES_PATH=prompts/examples_v5.2.json
# RECORDS_SUFFIX=_labels_v5.2.jsonl
# RESULTS_DIR=/path/to/results
# EXTRA_BODY_JSON={"chat_template_kwargs": {"thinking": false}}

# DeepSeek's own API (off-peak prices and the prompt-cache discount; README 8.4).
# The key is a DeepSeek platform key, put after NVIDIA_API_KEY= above. Thinking is ON by default there.
# NVIDIA_BASE_URL=https://api.deepseek.com
# NVIDIA_MODEL_ID=deepseek-flash
# EXTRA_BODY_JSON={"thinking": {"type": "disabled"}}

# Fireworks AI serverless (used for the 2026-11-06 run; README 8.4). Key from fireworks.ai.
# NVIDIA_BASE_URL=https://api.fireworks.ai/inference/v1
# NVIDIA_MODEL_ID=accounts/fireworks/models/deepseek-v4p1-flash
# SESSION_AFFINITY=flu-extractor-v5.2
# EXTRA_BODY_JSON={"reasoning_effort": "none"}
